# Runtime
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bombsell
DATABASE_POOL_MAX=10
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_APP_URL=
# Production target: nats_restate. Local/dev bridge: postgres.
BOMBSELL_SUBSTRATE=postgres

# Authentication and workspace isolation
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SESSION_SECRET=
# Base64-encoded 32-byte root key; encryption derives a separate key per workspace account.
CREDENTIALS_ENCRYPTION_KEY=
# Local seeded-dashboard access only. Never enable this in production.
BOMBSELL_ALLOW_DEMO_AUTH=0
BOMBSELL_DEMO_USER_ID=
BOMBSELL_DEMO_WORKSPACE_SLUG=default
# Optional verifier-only values for authenticated production smoke checks.
# Do not deploy these as app runtime secrets.
PRODUCTION_APP_COOKIE_HEADER=
PRODUCTION_APP_COOKIE=
PRODUCTION_APP_BEARER_TOKEN=
DASHBOARD_VERIFY_ORIGIN=
DASHBOARD_VERIFY_SCREENSHOTS=0

# LLM / evaluation
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_PROMPT_USD_PER_MILLION=0.14
DEEPSEEK_COMPLETION_USD_PER_MILLION=0.28
BOMBSELL_LLM_DAILY_TOKEN_CAP=100000
OPENAI_API_KEY=
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev/v2/scrape
EXA_API_KEY=
HUNTER_API_KEY=
HUNTER_API_BASE_URL=https://api.hunter.io/v2
ZEROBOUNCE_API_KEY=
ZEROBOUNCE_API_BASE_URL=https://api.zerobounce.net/v2
BOMBSELL_EXA_DAILY_QUERY_CAP=50
BOMBSELL_EXA_DAILY_CONTENTS_CAP=500
BOMBSELL_EXA_MONTHLY_UNIT_CAP=1000
BOMBSELL_EXA_PLAY_RESEARCH_CAP=25
BOMBSELL_RECOMMENDATION_RESEARCH_CADENCE_HOURS=24

# Owned-domain email and webhook trust
AWS_REGION=
# Supplied by an AWS credential provider in production; static keys are local-only.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_SNS_TOPIC_ARNS=arn:aws:sns:us-east-1:123456789012:bombsell-ses-events
AWS_SES_REQUIRED=0
SES_SENDING_DOMAIN=go.bombsell.com
SES_CONFIGURATION_SET=bombsell-outbound
SNS_VERIFY_SIGNATURES=1
PRODUCTION_GATE_STRICT=0

# Outlook / Microsoft Graph
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/outlook/callback
# Optional: single-tenant deployments set this to restrict accepted
# Graph lifecycle-token issuers to this tenant only. Multi-tenant
# deployments leave it unset and rely on aud + signature.
MICROSOFT_TENANT_ID=
OUTLOOK_DEFAULT_DAILY_CAP=25

# Native LinkedIn provider transport. Local/dev falls back to dry-run when empty;
# production defers safely until these are configured.
LINKEDIN_PROVIDER_URL=
LINKEDIN_PROVIDER_AUTH_URL=
LINKEDIN_PROVIDER_HEALTH_URL=
LINKEDIN_PROVIDER_API_KEY=
LINKEDIN_PROVIDER_WEBHOOK_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/linkedin/callback

# Transactional product email; never used for prospecting sends unless the
# managed owned-domain capacity switch below is intentionally enabled.
RESEND_API_KEY=
MANAGED_OWNED_DOMAIN_EMAIL_ENABLED=0
RESEND_WEBHOOK_SECRET=

# Billing / Dodo Payments
DODO_API_KEY=
DODO_ENV=live_mode
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_LAUNCH_MONTHLY=
DODO_PRODUCT_LAUNCH_ANNUAL=
DODO_BUSINESS_ID=

# Signal ingestion
PRODUCT_HUNT_TOKEN=
REDDIT_USER_AGENT=bombsell/1.0 contact@example.com
SEC_EDGAR_USER_AGENT=Bombsell contact@example.com
X_API_BEARER_TOKEN=
SOCIALDATA_API_KEY=
TWITTERAPI_IO_API_KEY=
SIGNAL_WEBHOOK_SECRET=

# Production substrate deployment
NATS_URL=nats://localhost:4222
# NATS NKEY+JWT credentials for Synadia Cloud / NGS (or any NKEY-auth server).
# Accepts EITHER the inline .creds file contents OR a path to a .creds file.
# Leave empty for unauthenticated or username:password-in-URL servers.
NATS_CREDS=
NATS_STREAM_MAX_BYTES=67108864
NATS_STREAM_MAX_AGE_MS=2592000000
RESTATE_INGRESS_URL=http://localhost:8080
RESTATE_ADMIN_URL=http://localhost:9070
RESTATE_ADMIN_TIMEOUT_MS=10000
# Optional bearer token for protected Restate Cloud/self-hosted ingress.
RESTATE_BEARER_TOKEN=
# Legacy alias for RESTATE_BEARER_TOKEN.
RESTATE_AUTH_TOKEN=
# Random secret presented by the external control-plane scheduler only.
MAINTENANCE_TRIGGER_SECRET=
# Vercel auto-injects this when a Cron is configured under the project; the
# maintenance route accepts EITHER MAINTENANCE_TRIGGER_SECRET or CRON_SECRET
# as the Bearer auth, so a single deployment can be driven by both Vercel
# Cron and an external scheduler (GitHub Actions, k8s CronJob, etc.).
CRON_SECRET=
RESTATE_WORKFLOW_PORT=9080
RESTATE_WORKFLOW_HTTP1=
RESTATE_ECS_CLUSTER=bombsell-workers
RESTATE_ECS_SERVICE=bombsell-restate-workflows
RESTATE_ECS_TARGET_GROUP_ARN=
RESTATE_ECS_LOG_GROUP=
RESTATE_ECS_CONTAINER_NAME=
RESTATE_ECS_LOG_LOOKBACK_MINUTES=60
RESTATE_ECS_LOG_SCAN_LIMIT=200
WORKER_TARGET_COMMAND=
# Leave unset for the managed-worker default. Restate-capable targets use 9081
# automatically so health checks do not collide with RESTATE_WORKFLOW_PORT=9080.
WORKER_HEALTH_PORT=
# Optional AWS exit cutover verifier knobs.
RENDER_CLI=
RENDER_BLUEPRINT_FILE=render.yaml
RENDER_WORKER_SERVICE_NAME=bombsell-production-worker
RENDER_WORKER_EXPECTED_PLAN=standard
RENDER_ALLOW_FREE_WORKER=0
RENDER_SKIP_RESTATE_CUTOVER=0
RENDER_SKIP_RUNTIME_GATES=0
RENDER_WORKER_HEALTH_TIMEOUT_MS=10000
# Optional Fly.io worker deploy and cutover verifier knobs.
FLY_API_TOKEN=
FLY_CLI=
FLY_CONFIG_FILE=fly.toml
FLY_ORG=
FLY_WORKER_ORG=
FLY_WORKER_APP_NAME=bombsell-production-worker
FLY_SKIP_RESTATE_CUTOVER=0
FLY_SKIP_RUNTIME_GATES=0
ACTIVATION_VERIFY_AGGREGATOR_LIMIT=4
# Optional outreach verifier knobs. The live provider smoke spends provider
# credits and should only be enabled in controlled staging checks.
OUTREACH_PIPELINE_STRICT=0
OUTREACH_PIPELINE_LIVE_PROVIDER_SMOKE=0
OUTREACH_PIPELINE_VERIFY_COMPANY_NAME=
OUTREACH_PIPELINE_VERIFY_COMPANY_DOMAIN=
OUTLOOK_REPAIR_WORKSPACE_ID=
OUTLOOK_REPAIR_LIMIT=500
KEEP_VERIFY_WORKSPACE=
