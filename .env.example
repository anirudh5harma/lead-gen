# Runtime
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bombsell
DATABASE_POOL_MAX=10
APP_ORIGIN=http://localhost:3000
BOMBSELL_SUBSTRATE=postgres

# Authentication and workspace isolation
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SESSION_SECRET=
# Base64-encoded 32-byte root key; encryption derives a separate key per workspace account.
CREDENTIALS_ENCRYPTION_KEY=
# Local seeded-dashboard access only. Never enable this in production.
BOMBSELL_ALLOW_DEMO_AUTH=0
BOMBSELL_DEMO_USER_ID=
BOMBSELL_DEMO_WORKSPACE_SLUG=default

# LLM / evaluation
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_PROMPT_USD_PER_MILLION=0.14
DEEPSEEK_COMPLETION_USD_PER_MILLION=0.28
BOMBSELL_LLM_DAILY_TOKEN_CAP=100000
OPENAI_API_KEY=

# Owned-domain email and webhook trust
AWS_REGION=
# Supplied by an AWS credential provider in production; static keys are local-only.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_SNS_TOPIC_ARNS=arn:aws:sns:us-east-1:123456789012:bombsell-ses-events
SNS_VERIFY_SIGNATURES=1

# Outlook / Microsoft Graph
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/outlook/callback
# Optional: single-tenant deployments set this to restrict accepted
# Graph lifecycle-token issuers to this tenant only. Multi-tenant
# deployments leave it unset and rely on aud + signature.
MICROSOFT_TENANT_ID=
OUTLOOK_DEFAULT_DAILY_CAP=25

# Transactional product email; never used for prospecting sends
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Signal ingestion
PRODUCT_HUNT_TOKEN=
REDDIT_USER_AGENT=bombsell/1.0 contact@example.com
SEC_EDGAR_USER_AGENT=Bombsell contact@example.com

# Production substrate deployment
NATS_URL=nats://localhost:4222
# NATS NKEY+JWT credentials for Synadia Cloud / NGS (or any NKEY-auth server).
# Accepts EITHER the inline .creds file contents OR a path to a .creds file.
# Leave empty for unauthenticated or username:password-in-URL servers.
NATS_CREDS=
RESTATE_INGRESS_URL=http://localhost:8080
# Random secret presented by the external control-plane scheduler only.
MAINTENANCE_TRIGGER_SECRET=
# Vercel auto-injects this when a Cron is configured under the project; the
# maintenance route accepts EITHER MAINTENANCE_TRIGGER_SECRET or CRON_SECRET
# as the Bearer auth, so a single deployment can be driven by both Vercel
# Cron and an external scheduler (GitHub Actions, k8s CronJob, etc.).
CRON_SECRET=
RESTATE_WORKFLOW_PORT=9080
