{
  "crons": [
    {
      "path": "/api/cron/poll-signals",
      "schedule": "0 0,12 * * *"
    },
    {
      "path": "/api/leads/match",
      "schedule": "10 0,12 * * *"
    },
    {
      "path": "/api/cron/deliver-leads",
      "schedule": "20 0,12 * * *"
    },
    {
      "path": "/api/cron/send-followups",
      "schedule": "30 0,12 * * *"
    },
    {
      "path": "/api/cron/send-automation",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/enrich-contacts",
      "schedule": "40 0,12 * * *"
    },
    {
      "path": "/api/cron/renew-inbox-watches",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/publish-content",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/ingest-content-inspiration",
      "schedule": "15 2 * * *"
